# Ubuntu Orange Edition distribution defaults.
# These are defaults, not locks: users may override them in their own dconf database.

[org/gnome/desktop/interface]
# Orange Edition is an orange-forward, saturated surface; prefer the dark
# GNOME scheme so shell/GTK chrome reads correctly against the orange theme.
color-scheme='prefer-dark'
icon-theme='Ubuntu-Orange'

[org/gnome/desktop/background]
picture-options='zoom'

# Start menu popup alignment for the Orange Edition Shell extension.
# This is a default, not a lock: users may override it in their own dconf database.
# The extension (shell-extension/orange-edition@mearvk/) must be installed and
# enabled for this key to take effect; the Start button itself always stays
# fixed at the left of the panel and only the popup honors this alignment.
[org/gnome/shell/extensions/orange-edition]
start-menu-alignment='left'
